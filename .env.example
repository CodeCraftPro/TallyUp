# TallyUp Environment Configuration (Optional)
# Port configuration (Defaults to first free port starting at 5001)
PORT=5001

# Receipt AI Engine Mode: "local" (default) or "llm"
LLM_ENGINE=local

# AI Provider: "gemini", "openai", "claude", or "custom"
LLM_PROVIDER=gemini

# API Key for chosen AI provider (leave blank if using local RapidOCR)
LLM_API_KEY=

# Model Name (Optional, defaults automatically based on provider)
# Gemini: gemini-1.5-flash (recommended) or gemini-1.5-pro
# OpenAI: gpt-4o-mini (recommended) or gpt-4o
# Claude: claude-3-5-sonnet-20241022 or claude-3-5-haiku-20241022
# Custom: e.g. llama3.2-vision
LLM_MODEL=gemini-1.5-flash

# Base URL (Optional, for OpenAI-compatible local/self-hosted endpoints)
# Example for Ollama: http://localhost:11434/v1
# Example for LocalAI: http://localhost:8080/v1
LLM_BASE_URL=

